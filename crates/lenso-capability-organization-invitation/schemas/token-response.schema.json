{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["invitation_id", "identifier", "organization_id", "email", "state", "inviter_subject", "accepted_subject", "revision", "token_expires_at", "acceptance_pending", "delivery_state", "created_at", "updated_at", "accepted_at", "revoked_at", "expired_at", "invitation_token", "token_returned"],
  "properties": {
    "invitation_id": { "type": "string" },
    "identifier": { "type": "string", "pattern": "^INV-[1-9][0-9]*$" },
    "organization_id": { "type": "string" },
    "email": { "type": "string", "x-lenso-sensitive": true },
    "state": { "enum": ["pending", "accepted", "revoked", "expired"] },
    "inviter_subject": { "type": "string" },
    "accepted_subject": { "type": ["string", "null"] },
    "revision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "token_expires_at": { "type": "string", "format": "date-time" },
    "acceptance_pending": { "type": "boolean" },
    "delivery_state": { "enum": ["pending", "queued", "failed", "superseded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "expired_at": { "type": ["string", "null"], "format": "date-time" },
    "invitation_token": { "type": ["string", "null"], "x-lenso-sensitive": true },
    "token_returned": { "type": "boolean" }
  },
  "additionalProperties": false
}
